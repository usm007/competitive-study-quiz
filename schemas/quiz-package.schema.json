{
  "additionalProperties": false,
  "properties": {
    "meta": {
      "additionalProperties": false,
      "properties": {
        "title": { "minLength": 1, "type": "string" },
        "source": { "type": "string" },
        "profile": { "type": "string" },
        "status": {
          "enum": ["COMPREHENSIVE", "PARTIAL", "LIMITED", "FAILED"],
          "type": "string"
        },
        "gate_reasons": { "items": { "type": "string" }, "type": "array" },
        "coverage_by_tier": { "type": "object" },
        "cognitive_by_tier": { "type": "object" },
        "purpose_coverage": { "type": "object" },
        "coverage_label": { "type": "string" },
        "cognitive_label": { "type": "string" },
        "blueprint_compliance": { "type": "object" },
        "revision_queue": { "type": "array" },
        "validated": { "minimum": 0, "type": "integer" },
        "total": { "minimum": 0, "type": "integer" },
        "by_type": {
          "patternProperties": { "^[a-z_]+$": { "minimum": 0, "type": "integer" } },
          "type": "object"
        },
        "by_purpose": { "type": "object" },
        "by_cognitive": { "type": "object" },
        "by_difficulty": { "type": "object" },
        "quality_accepted": { "minimum": 0, "type": "integer" },
        "quality_rejected": { "minimum": 0, "type": "integer" },
        "quality_sample": { "type": "object" },
        "top_rejection_reasons": { "type": "array" },
        "excluded": { "items": { "type": "string" }, "type": "array" },
        "external_count": { "minimum": 0, "type": "integer" }
      },
      "required": [
        "title",
        "source",
        "profile",
        "status",
        "gate_reasons",
        "coverage_by_tier",
        "validated",
        "total",
        "by_type",
        "excluded",
        "external_count"
      ],
      "type": "object"
    },
    "questions": { "items": { "type": "object" }, "type": "array" },
    "ku_excerpts": {
      "patternProperties": { "^KU-": { "type": "string" } },
      "type": "object"
    }
  },
  "required": ["meta", "questions"],
  "type": "object"
}