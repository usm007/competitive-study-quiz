    "block_id": "B-0096"
  },
  {
    "fact_id": "F-0005",
    "ku_id": "KU-0005",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "Article 14 of the Charter guarantees equality before the law to every person.",
    "ku_type": "article",
    "tier": 1,
    "block_id": "B-0128"
  },
  {
    "fact_id": "F-0006",
    "ku_id": "KU-0006",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "Article 15 bars discrimination on the grounds of birth, kinship, faith, domicile or means.",
    "ku_type": "article",
    "tier": 2,
    "block_id": "B-0129"
  },
  {
    "fact_id": "F-0007",
    "ku_id": "KU-0007",
    "trap": "plain",
