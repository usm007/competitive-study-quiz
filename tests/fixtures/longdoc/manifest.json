  {
    "fact_id": "F-0016",
    "ku_id": "KU-0016",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "The Charter lists eight writs for the enforcement of rights.",
    "ku_type": "definition",
    "tier": 3,
    "block_id": "B-0132"
  },
  {
    "fact_id": "F-0017",
    "ku_id": "KU-0017",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The writ of habeas corpus secures release from unlawful custody.",
    "ku_type": "list_item",
    "tier": 3,
    "block_id": "B-0133"
  },
  {
    "fact_id": "F-0018",
    "ku_id": "KU-0018",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The writ of mandamus commands a public body to perform its duty.",
    "ku_type": "list_item",
    "tier": 3,
    "block_id": "B-0134"
  },
  {
    "fact_id": "F-0019",
    "ku_id": "KU-0019",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The writ of prohibition restrains a lower forum from excess of jurisdiction.",
    "ku_type": "list_item",
    "tier": 3,
    "block_id": "B-0135"
  },
  {
    "fact_id": "F-0020",
    "ku_id": "KU-0020",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The writ of certiorari quashes orders passed with error apparent.",
    "ku_type": "list_item",
    "tier": 3,
    "block_id": "B-0136"
  },
  {
    "fact_id": "F-0021",
    "ku_id": "KU-0021",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The writ of quo warranto questions unlawful occupation of public office.",
    "ku_type": "list_item",
    "tier": 3,
    "block_id": "B-0137"
  },
  {
    "fact_id": "F-0022",
    "ku_id": "KU-0022",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The writ of certiorari before judgment transfers a pending matter upward.",
    "ku_type": "list_item",
    "tier": 3,
    "block_id": "B-0138"
  },
  {
    "fact_id": "F-0023",
    "ku_id": "KU-0023",
    "trap": "long_list_item",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The writ of review petition lies against orders passed without hearing.",
    "ku_type": "list_item",
    "tier": 2,
    "block_id": "B-0139"
  },
  {
    "fact_id": "F-0024",
    "ku_id": "KU-0024",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The writ of curative appeal lies after dismissal of a review petition.",
    "ku_type": "list_item",
    "tier": 3,
    "block_id": "B-0140"
  },
  {
    "fact_id": "F-0025",
    "ku_id": "KU-0025",
    "trap": "footnote_exception",
    "section": "Constitutional framework of the republic",
    "excerpt": "The right against preventive custody under Article 22 does not extend to persons held under a wartime detention ordinance, which is the sole exception to the custody code.",
    "ku_type": "exception",
    "tier": 2,
    "block_id": "B-0141"
  },
  {
    "fact_id": "F-0026",
    "ku_id": "KU-0026",
    "trap": "split_distinction",
    "section": "Constitutional framework of the republic",
    "excerpt": "The directive maxims of Part Four are guides for lawmaking and are not enforceable in any court.",
    "ku_type": "definition",
    "tier": 1,
    "block_id": "B-0143"
  },
  {
    "fact_id": "F-0027",
    "ku_id": "KU-0027",
    "trap": "split_distinction",
    "section": "Constitutional framework of the republic",
    "excerpt": "Unlike the enforceable rights of Part Three, the maxims of Part Four guide the state without creating claims that citizens can press in court.",
    "ku_type": "comparison",
    "tier": 1,
    "block_id": "B-0169"
  },
  {
    "fact_id": "F-0028",
    "ku_id": "KU-0028",
    "trap": "distributed_chronology",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The First Amendment of 1965 added the Ninth Schedule of protected land laws.",
    "ku_type": "amendment",
    "tier": 1,
    "block_id": "B-0171"
  },
  {
    "fact_id": "F-0029",
    "ku_id": "KU-0029",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The Second Amendment of 1968 revised the quorum of the upper house to forty members.",
    "ku_type": "amendment",
    "tier": 2,
    "block_id": "B-0172"
  },
  {
    "fact_id": "F-0030",
    "ku_id": "KU-0030",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The Third Amendment of 1971 inserted Article 16A on service tribunals.",
    "ku_type": "amendment",
    "tier": 2,
    "block_id": "B-0173"
  },
  {
    "fact_id": "F-0031",
    "ku_id": "KU-0031",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The Fourth Amendment of 1974 curtailed appeals in revenue matters.",
    "ku_type": "amendment",
    "tier": 2,
    "block_id": "B-0174"
  },
  {
    "fact_id": "F-0032",
    "ku_id": "KU-0032",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The Fifth Amendment of 1979 deleted the right to holdpton as a charter right.",
    "ku_type": "amendment",
    "tier": 2,
    "block_id": "B-0175"
  },
  {
    "fact_id": "F-0033",
    "ku_id": "KU-0033",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The Sixth Amendment of 1984 lowered the voting age to eighteen years.",
    "ku_type": "amendment",
    "tier": 2,
    "block_id": "B-0176"
  },
  {
    "fact_id": "F-0034",
    "ku_id": "KU-0034",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The Seventh Amendment of 1991 created the inter-state river board.",
    "ku_type": "amendment",
    "tier": 2,
    "block_id": "B-0177"
  },
  {
    "fact_id": "F-0035",
    "ku_id": "KU-0035",
    "trap": "plain",
    "section": "Constitutional framework of the republic",
    "excerpt": "- The Eighth Amendment of 2002 inserted Article 21A on free schooling for ages six to fourteen.",
    "ku_type": "amendment",
    "tier": 2,
    "block_id": "B-0178"
  },
  {
    "fact_id": "F-0036",
    "ku_id": "KU-0036",
    "trap": "repeated_detail",
    "section": "Constitutional framework of the republic",
    "excerpt": "The Charter originally contained two hundred and ninety articles, a count that later grew through amendment.",
